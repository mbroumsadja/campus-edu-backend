{
  "name": "campus-edu-backend",
  "version": "1.1.6",
  "description": "API de campus educatif",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "db:seed": "node developpement/seedDb.js",
    "db:reset": "node developpement/resetDb.js",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --config jest.unit.config.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:audit": "node scripts/audit-orphelins.js",
    "db:backfill-sujets": "node scripts/backfill-sujets-meta.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.7.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mysql2": "^3.24.4",
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.5",
    "sqlite3": "^6.0.1",
    "supertest": "^6.3.3"
  }
}
